<?xml version="1.0" encoding="UTF-8" ?>
<NamedCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Telegram Bot API</label>
    <!--
        Replace REPLACE_WITH_YOUR_BOT_TOKEN with the token BotFather gave you, either
        before deploying or afterwards in Setup > Named Credentials.

        The Telegram Bot API takes its credential as a path segment rather than a
        header, so the token lives in this endpoint. That keeps it out of Apex, SOQL,
        debug logs and the browser -- an org admin can still read it in Setup.
    -->
    <endpoint>https://api.telegram.org/botREPLACE_WITH_YOUR_BOT_TOKEN</endpoint>
    <generateAuthorizationHeader>false</generateAuthorizationHeader>
    <allowMergeFieldsInBody>false</allowMergeFieldsInBody>
    <allowMergeFieldsInHeader>false</allowMergeFieldsInHeader>
    <principalType>Anonymous</principalType>
    <protocol>NoAuthentication</protocol>
</NamedCredential>
