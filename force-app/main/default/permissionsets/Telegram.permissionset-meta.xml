<?xml version="1.0" encoding="UTF-8" ?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <applicationVisibilities>
        <application>Telegram_Setup</application>
        <visible>true</visible>
    </applicationVisibilities>
    <classAccesses>
        <apexClass>Telegram</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramCalloutQueueable</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramException</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramMessage</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramMessageParser</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramSetupController</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramUtility</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramWebhook</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>TelegramWebhookHandler</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <!--
        Reads Webhook_Secret__c and Handler_Class__c. The bot token is no longer
        stored here -- it lives in the Telegram_Bot_API Named Credential.
    -->
    <customMetadataTypeAccesses>
        <enabled>true</enabled>
        <name>Telegram_Setup__mdt</name>
    </customMetadataTypeAccesses>
    <description
    >Telegram Connector administration: run the setup component and register the webhook. Do NOT assign this to a site guest user -- use Telegram_Webhook_Guest for that.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>Telegram</label>
    <!-- TelegramSetupController queries ApexClass, which requires Author Apex. -->
    <userPermissions>
        <enabled>true</enabled>
        <name>AuthorApex</name>
    </userPermissions>
    <!-- TelegramSetupController.registerWebhook writes the secret via the Metadata API. -->
    <userPermissions>
        <enabled>true</enabled>
        <name>ModifyMetadata</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApiEnabled</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ApexRestServices</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>LightningExperienceUser</name>
    </userPermissions>
    <userPermissions>
        <enabled>true</enabled>
        <name>ViewSetup</name>
    </userPermissions>
</PermissionSet>
